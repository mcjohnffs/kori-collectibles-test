{% doc %}
  @prompt
    a fancy hero with a abit of fancy text on the left and on the right it should flip through products in the store add the shiny thing to them
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    z-index: 2;
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 24px;
    line-height: 1.1;
    font-weight: 700;
  }

  .ai-hero-heading-{{ ai_gen_id }} .ai-hero-gradient-text-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.gradient_color_1 }} 0%, {{ block.settings.gradient_color_2 }} 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
  }

  .ai-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .ai-hero-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-weight: 600;
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
  }

  .ai-hero-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  .ai-hero-products-{{ ai_gen_id }} {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-product-card-{{ ai_gen_id }} {
    position: absolute;
    width: 280px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-hero-product-card-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    z-index: 1;
  }

  .ai-hero-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 16px;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
  }

  .ai-hero-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-shine-{{ ai_gen_id }} {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      135deg,
      transparent 0%,
      transparent 40%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 60%,
      transparent 100%
    );
    transform: rotate(45deg);
    animation: ai-hero-shine-{{ ai_gen_id }} 3s infinite;
  }

  @keyframes ai-hero-shine-{{ ai_gen_id }} {
    0% {
      transform: translateX(-100%) translateY(-100%) rotate(45deg);
    }
    100% {
      transform: translateX(100%) translateY(100%) rotate(45deg);
    }
  }

  .ai-hero-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-hero-product-price-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.card_price_color }};
    font-weight: 700;
  }

  .ai-hero-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background }};
  }

  .ai-hero-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-hero-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-hero-products-{{ ai_gen_id }} {
      min-height: 400px;
    }
  }
{% endstyle %}

<ai-hero-{{ ai_gen_id }} class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-container-{{ ai_gen_id }}">
    <div class="ai-hero-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-hero-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">
          {{ block.settings.heading_before }}
          {% if block.settings.heading_gradient != blank %}
            <span class="ai-hero-gradient-text-{{ ai_gen_id }}">{{ block.settings.heading_gradient }}</span>
          {% endif %}
          {{ block.settings.heading_after }}
        </h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-hero-cta-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-hero-products-{{ ai_gen_id }}">
      {% if block.settings.products != blank %}
        {% for product in block.settings.products limit: 5 %}
          <div class="ai-hero-product-card-{{ ai_gen_id }}" data-product-index="{{ forloop.index0 }}">
            <div class="ai-hero-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-hero-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-hero-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-hero-shine-{{ ai_gen_id }}"></div>
            </div>
            <h3 class="ai-hero-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-hero-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </div>
        {% endfor %}
      {% else %}
        <div class="ai-hero-product-card-{{ ai_gen_id }} active">
          <div class="ai-hero-product-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-hero-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="ai-hero-shine-{{ ai_gen_id }}"></div>
          </div>
          <h3 class="ai-hero-product-title-{{ ai_gen_id }}">Add products to showcase</h3>
          <div class="ai-hero-product-price-{{ ai_gen_id }}">CHF 0.00</div>
        </div>
      {% endif %}
    </div>
  </div>
</ai-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class AiHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cards = [];
        this.interval = null;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.ai-hero-product-card-{{ ai_gen_id }}'));
        
        if (this.cards.length > 1) {
          this.cards[0].classList.add('active');
          this.startRotation();
        } else if (this.cards.length === 1) {
          this.cards[0].classList.add('active');
        }
      }

      startRotation() {
        this.interval = setInterval(() => {
          this.cards[this.currentIndex].classList.remove('active');
          this.currentIndex = (this.currentIndex + 1) % this.cards.length;
          this.cards[this.currentIndex].classList.add('active');
        }, {{ block.settings.rotation_speed | times: 1000 }});
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('ai-hero-{{ ai_gen_id }}', AiHero{{ ai_gen_id }});
  })();
</script>

